{
  "batch_size": 32,
  "dataset": {
    "repo_id": "local/robotwin-clean-eef16-h50",
    "root": "/path/to/prepared_robotwin_clean",
    "episodes": null,
    "image_transforms": {"enable": false},
    "revision": null,
    "use_imagenet_stats": true,
    "video_backend": "torchcodec",
    "return_uint8": false,
    "depth_output_unit": "mm",
    "streaming": false,
    "eval_split": 0.0
  },
  "env": null,
  "env_eval_freq": 0,
  "eval_steps": 0,
  "max_eval_samples": 0,
  "job_name": "zeva-ego-robotwin-clean-post-training",
  "log_freq": 20,
  "num_workers": 8,
  "optimizer": {
    "type": "adamw",
    "lr": 2.5e-5,
    "weight_decay": 1e-10,
    "grad_clip_norm": 1.0,
    "betas": [0.9, 0.95],
    "eps": 1e-8
  },
  "output_dir": "outputs/zeva-ego/robotwin-clean-post-training",
  "persistent_workers": true,
  "policy": {
    "type": "pi05",
    "n_obs_steps": 1,
    "input_features": {
      "observation.state": {"type": "STATE", "shape": [14]},
      "observation.images.cam_high": {"type": "VISUAL", "shape": [480, 640, 3]},
      "observation.images.cam_left_wrist": {"type": "VISUAL", "shape": [480, 640, 3]},
      "observation.images.cam_right_wrist": {"type": "VISUAL", "shape": [480, 640, 3]}
    },
    "output_features": {"action": {"type": "ACTION", "shape": [16]}},
    "device": "cuda",
    "use_amp": false,
    "use_peft": false,
    "push_to_hub": false,
    "repo_id": "local/zeva-ego-robotwin-clean",
    "pretrained_path": "/path/to/pi05_base_or_ego_mid_trained_checkpoint",
    "pretrained_revision": null,
    "paligemma_variant": "gemma_2b",
    "action_expert_variant": "gemma_300m",
    "dtype": "bfloat16",
    "chunk_size": 50,
    "n_action_steps": 50,
    "max_state_dim": 32,
    "max_action_dim": 32,
    "num_inference_steps": 10,
    "time_sampling_beta_alpha": 1.5,
    "time_sampling_beta_beta": 1.0,
    "time_sampling_scale": 0.999,
    "time_sampling_offset": 0.001,
    "min_period": 0.004,
    "max_period": 4.0,
    "use_relative_actions": false,
    "relative_exclude_joints": ["gripper"],
    "action_feature_names": ["left_eef", "right_eef", "grippers"],
    "image_resolution": [224, 224],
    "empty_cameras": 0,
    "tokenizer_max_length": 200,
    "normalization_mapping": {
      "ACTION": "QUANTILES",
      "STATE": "QUANTILES",
      "VISUAL": "IDENTITY"
    },
    "gradient_checkpointing": true,
    "compile_model": true,
    "compile_mode": "default",
    "freeze_vision_encoder": false,
    "train_expert_only": false,
    "optimizer_lr": 2.5e-5,
    "optimizer_betas": [0.9, 0.95],
    "optimizer_eps": 1e-8,
    "optimizer_weight_decay": 1e-10,
    "optimizer_grad_clip_norm": 1.0,
    "scheduler_warmup_steps": 1000,
    "scheduler_decay_steps": 30000,
    "scheduler_decay_lr": 2.5e-6
  },
  "prefetch_factor": 4,
  "rename_map": {},
  "resume": false,
  "save_checkpoint": true,
  "save_checkpoint_to_hub": false,
  "save_freq": 5000,
  "scheduler": {
    "type": "cosine_decay_with_warmup",
    "num_warmup_steps": 1000,
    "num_decay_steps": 30000,
    "peak_lr": 2.5e-5,
    "decay_lr": 2.5e-6
  },
  "seed": 0,
  "steps": 60000,
  "tolerance_s": 0.0001,
  "use_policy_training_preset": true,
  "wandb": {
    "enable": false,
    "disable_artifact": true,
    "project": "zeva-ego-robotwin",
    "entity": null,
    "notes": "RoboTwin clean-only post-training with chunk-start-relative EEF16 actions.",
    "run_id": null,
    "mode": null,
    "add_tags": true
  }
}
